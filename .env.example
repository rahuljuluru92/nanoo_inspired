# Copy to .env.local and fill in. NEVER commit .env.local and NEVER paste these values into chat
# (prompts are logged verbatim into a public repo).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by /go/[code] and the seed script. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Secret used to hash IPs for click de-duplication (any long random string).
CLICK_HASH_SECRET=
