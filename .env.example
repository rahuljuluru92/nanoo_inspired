# Copy to .env.local and fill in. NEVER commit .env.local and NEVER paste these values into chat
# (prompts are logged verbatim into a public repo). See DEPLOY.md for the hosted setup, step by step.

# Any Postgres 15+ works: the project-local cluster (npm run db:start), Neon, Supabase…
# Local:   postgres://postgres@127.0.0.1:54322/byline
# Hosted:  the *pooled* connection string for the running app (Neon: the "-pooler" host; Supabase: "Transaction pooler", port 6543).
#          For migrate/seed use the *direct* connection string instead (`npm run db:check` tells you which you have).
DATABASE_URL=

# Secret used to hash visitor IPs for click de-duplication (any long random string, e.g. `openssl rand -hex 32`).
CLICK_HASH_SECRET=

# Optional. Only for a custom domain; on Vercel the production hostname is picked up automatically.
# NEXT_PUBLIC_SITE_URL=https://byline.example
