# Copy to .env.local and fill in. NEVER commit .env.local and NEVER paste these values into chat
# (prompts are logged verbatim into a public repo).

# Any Postgres 15+ works: the project-local cluster (npm run db:start), Supabase, Neon…
# Local:      postgres://postgres@127.0.0.1:54322/byline
# Hosted:     the *pooled* connection string from your provider (Supabase: "Transaction pooler", port 6543).
DATABASE_URL=

# Secret used to hash visitor IPs for click de-duplication (any long random string).
CLICK_HASH_SECRET=
